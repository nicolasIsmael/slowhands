{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@engines/*": ["./src/engines/*"],
      "@storage/*": ["./src/storage/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": ["src", "fixtures/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/ui/testing/**", "src/**/testing/**"]
}
